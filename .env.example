# IDaaS Platform - Environment Variables Configuration
# Copy this file to .env and fill in the values for your environment

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
DEPLOYMENT_MODE=production  # Options: development, production

# =============================================================================
# DBaaS CONFIGURATION (Managed Database Service)
# =============================================================================
# YUGABYTEDB (PostgreSQL-compatible distributed SQL) - Managed DBaaS
# IMPORTANT: Replace with your DBaaS endpoint URL
# Format: jdbc:postgresql://hostname:port/database?ssl=true&sslmode=require
YUGABYTE_DB_URL=jdbc:postgresql://your-yugabyte-dbaas-endpoint:5433/keycloak?ssl=true&sslmode=require
YUGABYTE_USER=keycloak_prod
YUGABYTE_PASSWORD=CHANGEME_STRONG_PASSWORD_HERE

# DRAGONFLYDB (Redis-compatible in-memory datastore) - Managed DBaaS
# IMPORTANT: Replace with your DBaaS endpoint URL
# Format: redis://username:password@hostname:port/database?ssl=true
# For webapp cache (database 0)
DRAGONFLY_URL=redis://:CHANGEME_DRAGONFLY_PASSWORD@your-dragonfly-dbaas-endpoint:6379/0?ssl=true
# For OAuth2 session storage (database 1)
DRAGONFLY_SESSION_URL=redis://:CHANGEME_DRAGONFLY_PASSWORD@your-dragonfly-dbaas-endpoint:6379/1?ssl=true

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================
KEYCLOAK_HOSTNAME=auth.example.com  # Your Keycloak domain
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD_HERE

# =============================================================================
# WEBAPP CONFIGURATION
# =============================================================================
SECRET_KEY=CHANGEME_RANDOM_SECRET_KEY_HERE  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_HOSTNAME=app.example.com  # Your application domain
FLASK_ENV=production
LOG_LEVEL=INFO

# =============================================================================
# OAUTH2 PROXY CONFIGURATION
# =============================================================================
OAUTH2_CLIENT_ID=webapp-client
OAUTH2_CLIENT_SECRET=CHANGEME_CLIENT_SECRET_HERE
OAUTH2_COOKIE_SECRET=CHANGEME_32_BYTE_COOKIE_SECRET  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
OAUTH2_EMAIL_DOMAINS=*  # Or specific domain like: example.com
OAUTH2_OIDC_ISSUER_URL=http://keycloak:8080/realms/master
OAUTH2_REDIRECT_URL=http://localhost:4180/oauth2/callback

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
BUILD_DATE=2025-11-25
VCS_REF=main
APP_VERSION=1.0.0

# =============================================================================
# OPTIONAL: MONITORING & LOGGING
# =============================================================================
# LOG_LEVEL=INFO
# SENTRY_DSN=
# METRICS_ENABLED=true

# =============================================================================
# DBaaS NOTES
# =============================================================================
# This platform uses managed DBaaS for both databases (similar to AWS RDS):
#
# YugabyteDB DBaaS: Distributed SQL database (PostgreSQL-compatible)
#   - Fully managed service with automatic backups and HA
#   - No need to run database containers
#   - Use JDBC connection string format
#   - Ensure SSL/TLS is enabled for security
#   - Connection pooling and automatic failover included
#
# DragonflyDB DBaaS: High-performance in-memory datastore (Redis-compatible)
#   - Fully managed service
#   - ~25x faster than Redis for common operations
#   - Drop-in Redis replacement with same commands
#   - Separate URLs for different use cases (cache vs sessions)
#
# Benefits of using DBaaS:
#   ✅ Reduced hardware requirements (no database VMs needed)
#   ✅ Managed backups and disaster recovery
#   ✅ Automatic scaling and updates
#   ✅ Lower operational overhead
#   ✅ Built-in high availability and replication
#   ✅ Professional support and SLAs
#   ✅ Simplified deployment (only run application services)
#
# Hardware Savings:
#   - Previous: 2 VMs with 32GB RAM each for app + databases
#   - With DBaaS: 2 VMs with 8GB RAM each for apps only
#   - Savings: ~75% reduction in VM resource requirements
#
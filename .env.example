# IDaaS Platform - Environment Variables Configuration
# Copy this file to .env and fill in the values for your environment

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
DEPLOYMENT_MODE=production  # Options: development, production

# =============================================================================
# YUGABYTEDB CONFIGURATION (PostgreSQL-compatible distributed SQL)
# =============================================================================
YUGABYTE_DB=keycloak_prod
YUGABYTE_USER=keycloak_prod
YUGABYTE_PASSWORD=CHANGEME_STRONG_PASSWORD_HERE

# =============================================================================
# DRAGONFLYDB CONFIGURATION (Redis-compatible in-memory datastore)
# =============================================================================
DRAGONFLY_PASSWORD=CHANGEME_DRAGONFLY_PASSWORD_HERE  # Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================
KEYCLOAK_HOSTNAME=auth.example.com  # Your Keycloak domain
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME_ADMIN_PASSWORD_HERE

# =============================================================================
# WEBAPP CONFIGURATION
# =============================================================================
SECRET_KEY=CHANGEME_RANDOM_SECRET_KEY_HERE  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_HOSTNAME=app.example.com  # Your application domain

# =============================================================================
# OAUTH2 PROXY CONFIGURATION
# =============================================================================
OAUTH2_CLIENT_ID=webapp-client
OAUTH2_CLIENT_SECRET=CHANGEME_CLIENT_SECRET_HERE
OAUTH2_COOKIE_SECRET=CHANGEME_32_BYTE_COOKIE_SECRET  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32)[:32])"
OAUTH2_EMAIL_DOMAINS=*  # Or specific domain like: example.com

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
BUILD_DATE=2025-11-24
VCS_REF=main
APP_VERSION=1.0.0

# =============================================================================
# OPTIONAL: MONITORING & LOGGING
# =============================================================================
# LOG_LEVEL=INFO
# SENTRY_DSN=
# METRICS_ENABLED=true

# =============================================================================
# DATABASE NOTES
# =============================================================================
# YugabyteDB: Distributed SQL database (PostgreSQL-compatible)
#   - Port: 5433 (YSQL - PostgreSQL protocol)
#   - Web UI: http://localhost:9000 (in development mode)
#   - Use standard PostgreSQL tools and drivers
#
# DragonflyDB: High-performance in-memory datastore (Redis-compatible)
#   - Port: 6379 (Redis protocol)
#   - ~25x faster than Redis for common operations
#   - Drop-in Redis replacement with same commands
